<adonisControls:AdonisWindow x:Class="FModel.Views.LocResEditor"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             WindowStartupLocation="CenterOwner" IconVisibility="Collapsed"
                             Width="1050" Height="720" MinWidth="800" MinHeight="500">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="LocRes Editor"/>
        </Style>
    </adonisControls:AdonisWindow.Style>
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="OnSearchChanged"/>
            <TextBlock x:Name="CountText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <DataGrid x:Name="EntriesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Namespace" Binding="{Binding Namespace}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" IsReadOnly="True" Width="220"/>
                <DataGridTextColumn Header="Source Hash" Binding="{Binding SourceStringHash}" IsReadOnly="True" Width="110"/>
                <DataGridTextColumn Header="Localized String" Binding="{Binding LocalizedString, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save Copy" MinWidth="100" Margin="4" Click="OnSaveCopy"/>
                <Button Content="Save and Stage" MinWidth="120" Margin="4" Click="OnSaveAndStage"/>
                <Button Content="Close" MinWidth="90" Margin="4" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Grid>
</adonisControls:AdonisWindow>
