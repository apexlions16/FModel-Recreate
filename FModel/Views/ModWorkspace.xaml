<adonisControls:AdonisWindow x:Class="FModel.Views.ModWorkspace"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             WindowStartupLocation="CenterScreen" IconVisibility="Collapsed"
                             Width="1120" Height="760" MinWidth="900" MinHeight="620">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}">
            <Setter Property="Title" Value="Mod Workspace"/>
        </Style>
    </adonisControls:AdonisWindow.Style>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Background="{DynamicResource {x:Static adonisUi:Brushes.Layer2BackgroundBrush}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProjectTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProjectDirectory}" Opacity="0.72" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SupportSummary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New Project" MinWidth="105" Margin="4" Click="OnNewProject" IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Open Project" MinWidth="105" Margin="4" Click="OnOpenProject" IsEnabled="{Binding IsNotBusy}"/>
                    <Button Content="Open Folder" MinWidth="95" Margin="4" Click="OnOpenProjectFolder" IsEnabled="{Binding HasProject}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Project &amp; Build">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project Name" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="UE4 Minor Version" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding EngineMinorVersions}" SelectedItem="{Binding EngineMinor}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Game Directory" VerticalAlignment="Center"/>
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" MinWidth="85" Click="OnBrowseGame"/>
                        </Grid>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Content/Paks" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PaksDirectory}" IsReadOnly="True"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Mount Point" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MountPoint, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="6" Grid.Column="3" Text="PAK Version" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding RepakVersion, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Build Backend" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}"/>
                        <TextBlock Grid.Row="8" Grid.Column="3" Text="Compression" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="8" Grid.Column="4" ItemsSource="{Binding Compressions}" SelectedItem="{Binding Compression}"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="UnrealPak.exe" VerticalAlignment="Center"/>
                        <Grid Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding UnrealPakPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" MinWidth="85" Click="OnBrowseUnrealPak"/>
                        </Grid>

                        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Analyze Game" MinWidth="110" Margin="4" Click="OnAnalyze" IsEnabled="{Binding IsNotBusy}"/>
                            <Button Content="Save Profile" MinWidth="105" Margin="4" Click="OnSaveProfile" IsEnabled="{Binding HasProject}"/>
                            <Button Content="Validate" MinWidth="90" Margin="4" Click="OnValidate" IsEnabled="{Binding HasProject}"/>
                            <Button Content="Build _P.pak" MinWidth="120" Margin="4" Click="OnBuild" IsEnabled="{Binding HasProject}"/>
                            <Button Content="Install" MinWidth="90" Margin="4" Click="OnInstall" IsEnabled="{Binding HasProject}"/>
                            <Button Content="Uninstall" MinWidth="90" Margin="4" Click="OnUninstall" IsEnabled="{Binding HasProject}"/>
                        </StackPanel>

                        <Grid Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <GroupBox Header="Compatibility Analysis" Padding="8">
                                <ListBox ItemsSource="{Binding AnalysisMessages}"/>
                            </GroupBox>
                            <GroupBox Grid.Column="2" Header="Project Validation" Padding="8">
                                <ListBox ItemsSource="{Binding ValidationMessages}"/>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Staged Assets">
                <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Cooked Files" MinWidth="120" Margin="4" Click="OnAddCookedFiles" IsEnabled="{Binding HasProject}"/>
                        <Button Content="Open LocRes Editor" MinWidth="135" Margin="4" Click="OnOpenLocRes" IsEnabled="{Binding HasProject}"/>
                        <Button Content="Remove Selected" MinWidth="120" Margin="4" Click="OnRemoveSelected" IsEnabled="{Binding HasProject}"/>
                    </StackPanel>
                    <DataGrid x:Name="AssetsGrid" Grid.Row="2" ItemsSource="{Binding AssetGroups}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Logical Path" Binding="{Binding LogicalPath}" Width="*"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceKind}" Width="150"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files.Count}" Width="80"/>
                            <DataGridTextColumn Header="Added" Binding="{Binding AddedUtc}" Width="180"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Files}" Margin="20,4,4,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding VirtualPath}"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Texture / Audio Conversion">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Conversion Type" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ConversionKinds}" SelectedItem="{Binding ConversionKind}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="UE4 Engine Root" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EngineRoot, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse" Margin="8,0,0,0" MinWidth="85" Click="OnBrowseEngine"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Source PNG/TGA/DDS/WAV" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConversionSource, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="Browse" Margin="8,0,0,0" MinWidth="85" Click="OnBrowseConversionSource"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Target Virtual .uasset" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ConversionTarget, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: GameName/Content/UI/T_Logo.uasset"/>
                    <Button Grid.Row="8" Grid.Column="1" Content="Convert, Cook and Stage" MinWidth="180" HorizontalAlignment="Left" Click="OnConvert" IsEnabled="{Binding HasProject}"/>
                    <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Opacity="0.75"
                               Text="Conversion requires the matching Unreal Engine 4 installation. It creates an isolated temporary project, imports the source, cooks for WindowsNoEditor, then stages the resulting .uasset sidecars."/>
                </Grid>
            </TabItem>

            <TabItem Header="Logs">
                <TextBox Margin="10" Text="{Binding LogText}" IsReadOnly="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ProgressBar Width="180" Height="16" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Cancel" Margin="8,0,0,0" MinWidth="80" Click="OnCancel" IsEnabled="{Binding IsBusy}"/>
            </StackPanel>
        </Grid>
    </Grid>
</adonisControls:AdonisWindow>
