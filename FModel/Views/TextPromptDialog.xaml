<adonisControls:AdonisWindow x:Class="FModel.Views.TextPromptDialog"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                             Width="520" Height="190" IconVisibility="Collapsed">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueText" Grid.Row="2" MinWidth="450"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="OK" MinWidth="90" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</adonisControls:AdonisWindow>
